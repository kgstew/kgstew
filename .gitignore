# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/

/temp

# This repository is public. Working notes — positioning drafts, interview
# transcripts, the content brief — stay local: they contain client details under
# NDA, candid notes about collaborators, and unpublished biographical material.
/docs

# Asset originals live here for convenience but are never committed or uploaded —
# only their derivatives go to Blob. The captions sidecars ARE tracked: they are
# hand-written content, they are tiny, and losing them means re-describing every
# photo by hand.
/originals/**
!/originals/**/
!/originals/**/captions.yaml
!/originals/README.md

# Dry-run manifests are scratch output for inspecting shape before an upload.
content/assets/*.dry.json
/.pnp
.pnp.js
/.yarn/*
!/.yarn/releases
!/.yarn/plugins
!/.yarn/sdks

# testing
/coverage

# next.js
/.next/
/out/
public/sitemap.xml
.vercel

# production
/build
*.xml

# rss feed
/public/feed.xml

# search
/public/search.json

# misc
.DS_Store

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Contentlayer
.contentlayer
.env*.local

# Real redaction terms — the denylist the leak scan checks published content
# against. Gitignored because it necessarily contains the strings we're
# protecting. redactions.example.json shows the shape.
content/private/redactions.json
